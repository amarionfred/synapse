{
  "$schema": "https://opencode.ai/config.json",
  "model": "qwen-local/qwen3.5-4b-q4km",
  "small_model": "qwen-local/qwen3.5-4b-q4km",
  "enabled_providers": ["qwen-local"],
  "default_agent": "probe",
  "autoupdate": false,
  "share": "disabled",
  "snapshot": false,
  "provider": {
    "qwen-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Qwen on this laptop",
      "options": {
        "baseURL": "http://127.0.0.1:8087/v1",
        "apiKey": "local-only"
      },
      "models": {
        "qwen3.5-4b-q4km": {
          "name": "Qwen3.5-4B Q4_K_M (CPU)",
          "limit": {"context": 16384, "output": 1024}
        }
      }
    }
  },
  "agent": {
    "probe": {
      "description": "Short, reproducible text probes of the local model",
      "mode": "primary",
      "prompt": "You are a helpful assistant. Answer the user's request directly and concisely.",
      "temperature": 0,
      "tools": {"*": false}
    }
  }
}
